# Brindix — copia este archivo como .env y ajusta los valores.
# En desarrollo no hace falta nada: el backend usa H2 en ./data y crea datos de ejemplo.

# ---- Perfil: dev (H2 en archivo) | prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# ---- Base de datos (perfil prod)
DATABASE_URL=jdbc:postgresql://db:5432/brindix
DATABASE_USER=brindix
DATABASE_PASSWORD=cambia-esta-clave

# ---- Seguridad: secreto largo y aleatorio (mínimo 32 caracteres)
BRINDIX_JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio-de-64-caracteres
BRINDIX_JWT_HOURS=14

# ---- Direcciones públicas
# Donde se abre la app (los QR de las mesas apuntan aquí)
BRINDIX_PUBLIC_URL=https://bar.tudominio.com
BRINDIX_CORS_ORIGINS=https://bar.tudominio.com
BRINDIX_TIMEZONE=America/Bogota
BRINDIX_UPLOADS_DIR=/data/uploads

# ---- Primer arranque (solo se usa si la base está vacía)
BRINDIX_SEED=true
BRINDIX_VENUE_NAME=Mi Bar
BRINDIX_ADMIN_USER=admin
BRINDIX_ADMIN_PASSWORD=cambia-esta-clave-ya
BRINDIX_WAITER_PASSWORD=cambia-esta-tambien

# ---- Spotify (opcional, ver docs/SPOTIFY.md)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://bar.tudominio.com/api/spotify/callback
SPOTIFY_MARKET=CO
