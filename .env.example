# Brindix — en el servidor este archivo lo crea scripts/init-env.sh (claves aleatorias y
# credenciales de Spaces / fal.ai / DeepSeek copiadas de Aula Interactiva).
# En desarrollo no hace falta: el backend usa H2 en ./data y crea el bar "demo".

SPRING_PROFILES_ACTIVE=prod
BRINDIX_PORT=5710

# ---- Base de datos MySQL (contenedor "db")
DATABASE_USER=brindix
DATABASE_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-otra

# ---- Seguridad (largas y aleatorias; si cambias BRINDIX_SECRET_KEY hay que volver a poner las claves de Spotify/YouTube)
BRINDIX_JWT_SECRET=
BRINDIX_SECRET_KEY=
BRINDIX_JWT_HOURS=24

# ---- Direcciones públicas
BRINDIX_PUBLIC_URL=https://brindix.cania.app
BRINDIX_API_URL=https://brindix.cania.app
BRINDIX_CORS_ORIGINS=https://brindix.cania.app
BRINDIX_TIMEZONE=America/Bogota
BRINDIX_WHATSAPP=573229457553

# ---- Primer arranque
BRINDIX_SEED=true
BRINDIX_SUPER_USER=brindix
BRINDIX_SUPER_PASSWORD=
BRINDIX_DEMO_VENUE=true
BRINDIX_ADMIN_PASSWORD=
BRINDIX_WAITER_PASSWORD=

# ---- DigitalOcean Spaces (bucket compartido; Brindix guarda todo bajo SPACES_PREFIX/<bar>/)
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_BUCKET=cania-storage
SPACES_PREFIX=brindix
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=

# ---- IA para redactar descripciones (compatible con OpenAI; DeepSeek por defecto)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# ---- fal.ai: imágenes de prueba (scripts/seed-images.py) y música de fondo de los videos (una vez por estilo)
FAL_KEY=

# ---- Estudio de videos (/plataforma → Videos). Lo llena scripts/set-studio.sh en el servidor.
# Token compartido entre el backend y el contenedor "studio" (aleatorio, largo).
STUDIO_TOKEN=
# Voz de la copa: Fish Audio (misma cuenta que Canix / Aula Interactiva).
FISH_API_KEY=
FISH_MODEL=s2-pro
# Bar y usuarios que el estudio usa para grabar las pantallas reales (el bar "demo" y sus accesos).
STUDIO_VENUE=demo
STUDIO_ADMIN_USER=admin
STUDIO_ADMIN_PASS=
STUDIO_WAITER_USER=mesero
STUDIO_WAITER_PASS=

# La música (Spotify / YouTube) NO va aquí: cada bar la configura en
# Panel del administrador → Configuración → Música.

# Carta del bar demo para el botón "Ver una carta real" de la landing (vacío = sin botón)
BRINDIX_DEMO_URL=

# Recupera la contraseña del súper administrador desde /plataforma (mínimo 24 caracteres; solo en el servidor)
BRINDIX_RECOVERY_KEY=

# Correo saliente (Brevo: smtp-relay.brevo.com, 587). Lo llena scripts/set-mail.sh en el servidor
BRINDIX_MAIL_HOST=
BRINDIX_MAIL_PORT=587
BRINDIX_MAIL_USERNAME=
BRINDIX_MAIL_PASSWORD=
BRINDIX_MAIL_FROM=no-responder@cania.app
BRINDIX_MAIL_FROM_NAME=Brindix
# Correo del súper administrador (recuperación y avisos de seguridad)
BRINDIX_ADMIN_EMAIL=franmacagu@gmail.com
