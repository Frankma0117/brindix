# ===== Publicador · un .env por proyecto =====

# --- Básico ---
PORT=3100
# Dirección pública (https) de ESTE publicador: aquí regresan los inicios de sesión de las redes y de aquí
# descargan los videos y las imágenes (Meta, TikTok). Ej.: https://publicador.brindix.cania.app
PUBLIC_URL=
# Nombre del proyecto (se ve en el panel y en los avisos)
PROJECT_NAME=Mi proyecto
# Contraseña del panel. Si se deja vacía se crea una al azar en data/admin-password.txt
PUBLISHER_ADMIN_PASSWORD=
# Texto para cifrar los tokens de las redes. Si se deja vacío se crea data/publisher.key. Respáldalo.
PUBLISHER_SECRET=
# Llave para que el software del proyecto envíe videos a la biblioteca (POST /api/v1/assets). Opcional.
PUBLISHER_API_KEY=

# --- Avisos y aprobaciones por WhatsApp (a través de Canix). Opcional ---
# Se crean en Canix → Plataforma → Sistema → Proyectos conectados. Webhook: <PUBLIC_URL>/api/canix/webhook
CANIX_URL=https://canix.cania.app
CANIX_API_KEY=
CANIX_WEBHOOK_SECRET=

# --- IA (opcional: sin ellas los textos salen de plantilla y el arte es un degradado de la marca) ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
FAL_KEY=
# Modelo de imagen del estudio (por defecto fal-ai/flux/dev)
STUDIO_IMAGE_MODEL=

# --- Archivos: disco del servidor o DigitalOcean Spaces (opcional) ---
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
DO_SPACES_PREFIX=publisher/

# --- Redes (cada proyecto crea sus propias apps; guía paso a paso en docs/REDES.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY=private
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY

# --- Modo incrustado (el publicador como sección del panel de un proyecto; ver docs/INCRUSTADO.md) ---
EMBEDDED=false
EMBED_SECRET=
BASE_PATH=
EMBED_RETURN_URL=/
PROJECT_WEBHOOK_URL=
